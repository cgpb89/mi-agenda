# ─────────────────────────────────────────────────────────────────────────────
# Tempo — environment configuration
# Copy to `.env` for local development. NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; none are needed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
# Public origin of the app. Used for absolute links (reset/manage emails) and
# the Origin check on mutating route handlers.
APP_URL=http://localhost:3000

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Runtime connection used by the app (Prisma driver adapter `pg`).
# Recommended: Supabase Supavisor TRANSACTION pooler, port 6543:
#   postgresql://tempo_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Use the least-privilege `tempo_app` role (see prisma/sql/roles.sql), not `postgres`.
DATABASE_URL=
# Max pooled connections per server instance (keep small with serverless).
DATABASE_POOL_MAX=5

# Direct (or SESSION pooler, port 5432) connection used ONLY by the Prisma CLI
# for migrations, and by admin scripts. Uses the migration/owner role.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=

# ── Supabase API (optional, currently unused by the app) ─────────────────────
# Supabase → Project Settings → API. The app does NOT use these to reach the
# database (Prisma uses the Postgres URLs above) and does NOT use Supabase Auth.
# They are validated at startup: NEXT_PUBLIC_SUPABASE_URL must belong to the
# same project as DATABASE_URL / DIRECT_URL. Keep the service-role key
# server-only — never prefix it with NEXT_PUBLIC_ and never use it in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# HMAC key for session-token hashing (pepper). Rotating it signs everyone out.
SESSION_SECRET=
# HMAC key for password-reset, invitation and booking-manage tokens.
PASSWORD_RESET_TOKEN_SECRET=
# HMAC key used to derive privacy-preserving rate-limit keys and log fingerprints.
RATE_LIMIT_SECRET=

# ── Rate limiting ────────────────────────────────────────────────────────────
# `postgres` (shared across instances; production default) or `memory`
# (single-process, development only — refused when NODE_ENV=production).
RATE_LIMIT_STORE=postgres
# Trust X-Forwarded-For / X-Real-IP for client IPs. Enable ONLY behind a proxy
# that overwrites these headers (Vercel, Fly, a configured nginx, ...).
TRUST_PROXY_HEADERS=false

# ── Email (optional) ─────────────────────────────────────────────────────────
# When unset, emails are NOT sent. In development they are written to the server
# console instead; in production the UI never claims an email was sent.
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# ── Photo uploads (optional) ──────────────────────────────────────────────────
# Cloudinary → Settings → API Keys. Booking-page photos are uploaded straight from
# the browser with a short-lived signature; the secret never leaves the server.
# When unset, the photo uploader is disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# ── Tests (put these in .env.test.local, never in .env) ──────────────────────
# A SEPARATE Supabase project used only by automated tests. Tests TRUNCATE data.
# TEST_DATABASE_URL=
# TEST_DIRECT_URL=
# Must be `true` for integration/e2e tests to touch the database.
# ALLOW_DESTRUCTIVE_DB_TESTS=false
# Comma-separated Supabase project refs (or hostnames) tests may run against.
# TEST_DB_PROJECT_ALLOWLIST=
